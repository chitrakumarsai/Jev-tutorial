{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm --prefix web run:*)",
      "Bash(npm --prefix web test:*)",
      "Bash(npm --prefix web ci)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Edit(./.claude/**)",
      "Edit(./scripts/hooks/**)",
      "Edit(./.pre-commit-config.yaml)",
      "Edit(./.github/workflows/**)",
      "Edit(./pyproject.toml)",
      "Edit(./web/package.json)",
      "Edit(./web/eslint.config.js)",
      "Edit(./web/vite.config.ts)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Bash(git diff --no-index:*)",
      "Bash(git diff --output:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(uv publish:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(ssh:*)"
    ]
  },
  "env": {
    "UV_CACHE_DIR": ".cache/uv"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre_tool_guard.sh",
            "timeout": 10,
            "statusMessage": "Checking secrets and budget guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post_edit.sh",
            "timeout": 60,
            "statusMessage": "Formatting and linting edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && timeout 120 uv run pytest -q",
            "timeout": 130,
            "statusMessage": "Running Python tests"
          }
        ]
      }
    ]
  }
}
