      "SummaryRow": {
        "description": "A scenario-specific results row. The UI formats `value` by `kind` and shows `note`\nafter it; it never computes anything from it. Both sides of a run must use the same\nlabels: the UI lines their rows up by label, in the first side's order.",
        "properties": {
          "kind": {
            "enum": [
              "count",
              "money",
              "text"
            ],
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ok"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "label",
          "kind",
          "value"
        ],
        "title": "SummaryRow",
        "type": "object"
      },
      "VarianceTotal": {
        "description": "S1's total variance against the answer key's.",
        "properties": {
          "exact": {
            "readOnly": true,
            "title": "Exact",
            "type": "boolean"
          },
          "expected": {
            "title": "Expected",
            "type": "string"
          },
          "reported": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reported"
          }
        },
        "required": [
          "expected",
          "reported",
          "exact"
        ],
        "title": "VarianceTotal",
        "type": "object"
      }
    }
  },
