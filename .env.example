# Copy to .env and fill in. Never commit .env (it is git-ignored).

# TypeSafe (Jev) key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# OpenAI key for the baseline LLM
OPENAI_API_KEY=

# Baseline model (presenter decision: cheapest current model)
OPENAI_MODEL=gpt-6-luna
JEV_MODEL=jev-latest

# Live API calls are OFF by default. Replay mode needs no keys and costs nothing.
LIVE_ENABLED=false
# Hard spend cap per API key in USD. May be lowered, never above 5.00.
BUDGET_CAP_USD=5.00

# uv's default cache (~/.cache/uv) is not writable in some sandboxes; use a repo-local one.
UV_CACHE_DIR=.cache/uv
